[data-theme="dark"] .ai-note-text     { color: #f1f5f9 !important; }
[data-theme="dark"] .ai-note-text p:last-child:not(:only-child) { color: #cbd5e1 !important; }
[data-theme="dark"] .ai-note-fallback { color: #94a3b8 !important; }
[data-theme="dark"] .ai-note-sub      { color: #94a3b8 !important; }
[data-theme="dark"] .ai-note-title h3 { color: #d1fae5 !important; }
[data-theme="dark"] .ai-note-refresh {
  background: #14202f !important;
  border-color: #1e3a2a !important;
  color: #4caf50 !important;
}
[data-theme="dark"] .ai-skeleton-line {
  background: linear-gradient(90deg, #1e2d40 0%, #2a3b53 50%, #1e2d40 100%) !important;
}

/* Plant Doctor result tweaks */
[data-theme="dark"] .pd-result-section h5 { color: #94a3b8 !important; }
[data-theme="dark"] .pd-result-meta       { color: #cbd5e1 !important; }
[data-theme="dark"] .pd-empty,
[data-theme="dark"] .pd-loading p,
[data-theme="dark"] .pc-empty p           { color: #cbd5e1 !important; }

/* Garden Map zone canvases */
[data-theme="dark"] .gm-canvas { filter: brightness(0.6) saturate(0.85); border-color: #2a3b53 !important; }
[data-theme="dark"] .gm-canvas-empty,
[data-theme="dark"] .gm-canvas-loading p { color: #cbd5e1 !important; }
[data-theme="dark"] .gm-canvas-empty h3  { color: #f1f5f9 !important; }
[data-theme="dark"] .gm-tile-label       { background: rgba(0,0,0,0.85) !important; }
[data-theme="dark"] .gm-hint {
  background: rgba(120, 53, 15, 0.15) !important;
  border-color: rgba(245, 158, 11, 0.3) !important;
  color: #fde68a !important;
}

/* Plant Anatomy */

/* ================================================================
   Dark Mode — kicks in when <html data-theme="dark"> is set.
   Single override file: leaves brand greens alone, swaps neutral
   surfaces, text, borders, and inputs.
================================================================ */

[data-theme="dark"] {
  color-scheme: dark;

  /* Surface tokens — refined for better contrast and depth */
  --bj-bg:           #0a0f1c;   /* page background — slightly deeper */
  --bj-surface:      #14202f;   /* card background */
  --bj-surface-2:    #1e2d40;   /* nested / hover */
  --bj-surface-3:    #2a3b53;   /* deeper */
  --bj-border:       #2a3b53;
  --bj-border-soft:  #1a2536;
  --bj-text:         #f1f5f9;   /* primary text — brighter */
  --bj-text-muted:   #cbd5e1;
  --bj-text-subtle:  #94a3b8;
  --bj-input-bg:     #0a0f1c;
}

/* ── Global surfaces ─────────────────────────────────── */
[data-theme="dark"],
[data-theme="dark"] body,
[data-theme="dark"] .container,
[data-theme="dark"] .app,
[data-theme="dark"] .main-content {
  background: #0a0f1c !important;
  color: #e5e7eb;
}

[data-theme="dark"] body { background: #0a0f1c !important; }

/* Containers with hardcoded light backgrounds */
[data-theme="dark"] .my-plants-container,
[data-theme="dark"] .plant-journal-container,
[data-theme="dark"] .care-tasks,
[data-theme="dark"] .plant-encyclopedia,
[data-theme="dark"] .pd-container,
[data-theme="dark"] .pc-container,
[data-theme="dark"] .gm-container,
[data-theme="dark"] .profile-container-modern,
[data-theme="dark"] .plant-detail-wrapper {
  background: #0a0f1c !important;
}

/* ── Sidebar ─────────────────────────────────────────── */
[data-theme="dark"] .sidebar,
[data-theme="dark"] .mobile-drawer {
  background: #111827 !important;
  border-color: #1f2937 !important;
  color: #e5e7eb;
}
[data-theme="dark"] .logo-text h1,
[data-theme="dark"] .logo-text p,
[data-theme="dark"] .nav-title {
  color: #cbd5e1 !important;
}
[data-theme="dark"] .nav-links-item {
  color: #cbd5e1 !important;
}
[data-theme="dark"] .nav-links-item:hover {
  background: #14202f !important;
  color: #ffffff !important;
}
[data-theme="dark"] .nav-links-item.active {
  background: rgba(76, 175, 80, 0.18) !important;
  color: #d1fae5 !important;
}
[data-theme="dark"] .bottom-nav,
[data-theme="dark"] .bottom-tab {
  background: #111827 !important;
  color: #cbd5e1;
}
[data-theme="dark"] .bottom-tab.active { color: #4caf50; }

/* ── Header ──────────────────────────────────────────── */
[data-theme="dark"] .dashboard-header {
  background: #111827 !important;
  border-color: #1f2937 !important;
}
[data-theme="dark"] .greeting-title,
[data-theme="dark"] .user-fullname { color: #f3f4f6 !important; }
[data-theme="dark"] .greeting-details,
[data-theme="dark"] .user-meta-info,
[data-theme="dark"] .date-info,
[data-theme="dark"] .time-info { color: #cbd5e1 !important; }
[data-theme="dark"] .quick-stat {
  background: #14202f !important;
  color: #f1f5f9 !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .user-profile-card {
  background: #14202f !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .user-profile-card:hover {
  background: #1e2d40 !important;
}

/* ── Cards & generic surfaces ───────────────────────── */

  background: linear-gradient(180deg, #1a2332 0%, #1a2332 50%, #1f2e23 50%, #19281e 100%) !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .pa-info { background: #14202f !important; border-color: #2a3b53 !important; }
[data-theme="dark"] .pa-info h3       { color: #f1f5f9 !important; }
[data-theme="dark"] .pa-info p        { color: #cbd5e1 !important; }
[data-theme="dark"] .pa-info .pa-tagline { color: #94a3b8 !important; }
[data-theme="dark"] .pa-fact { background: #0a0f1c !important; color: #f1f5f9 !important; }
[data-theme="dark"] .pa-facts h4 { color: #94a3b8 !important; }
[data-theme="dark"] .pa-empty   { color: #94a3b8 !important; }
[data-theme="dark"] .pa-chip {
  background: #14202f !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}

/* Carbon Offset */
[data-theme="dark"] .co-stat,
[data-theme="dark"] .co-section {
  background: #14202f !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .co-stat-value         { color: #f1f5f9 !important; }

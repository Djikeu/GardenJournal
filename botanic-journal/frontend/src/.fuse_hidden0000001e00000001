[data-theme="dark"] h2,
[data-theme="dark"] h3,
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6 { color: #f3f4f6; }

[data-theme="dark"] p,
[data-theme="dark"] li,
[data-theme="dark"] span,
[data-theme="dark"] label {
  color: inherit;
}

[data-theme="dark"] .task-title,
[data-theme="dark"] .plant-name,
[data-theme="dark"] .journal-title,
[data-theme="dark"] .card-title,
[data-theme="dark"] .stat-number,
[data-theme="dark"] .stat-value,
[data-theme="dark"] .stat-value-compact,
[data-theme="dark"] .stat-number-modern { color: #f3f4f6 !important; }

[data-theme="dark"] .task-description,
[data-theme="dark"] .task-plant,
[data-theme="dark"] .plant-species,
[data-theme="dark"] .plant-description,
[data-theme="dark"] .journal-text,
[data-theme="dark"] .journal-date,
[data-theme="dark"] .stat-label,
[data-theme="dark"] .stat-label-compact,
[data-theme="dark"] .stat-label-modern,
[data-theme="dark"] .stat-trend-compact,
[data-theme="dark"] .meta-label,
[data-theme="dark"] .meta-value,
[data-theme="dark"] .info-label,
[data-theme="dark"] .info-value { color: #cbd5e1 !important; }

[data-theme="dark"] .text-counter,
[data-theme="dark"] .hero-subtitle,
[data-theme="dark"] .post-time,
[data-theme="dark"] .progress-text { color: #94a3b8 !important; }

/* Card headers */
[data-theme="dark"] .card-header {
  border-bottom-color: #334155 !important;
}

/* ── Inputs / forms ──────────────────────────────────── */
[data-theme="dark"] input[type="text"],
[data-theme="dark"] input[type="email"],
[data-theme="dark"] input[type="password"],
[data-theme="dark"] input[type="search"],
[data-theme="dark"] input[type="date"],
[data-theme="dark"] input[type="number"],
[data-theme="dark"] textarea,
[data-theme="dark"] select,
[data-theme="dark"] .form-input,
[data-theme="dark"] .form-select,
[data-theme="dark"] .form-textarea,
[data-theme="dark"] .search-input,
[data-theme="dark"] .search-input-enhanced,
[data-theme="dark"] .sort-select {
  background: #0a0f1c !important;
  color: #f1f5f9 !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] input:focus,
[data-theme="dark"] textarea:focus,
[data-theme="dark"] select:focus,
[data-theme="dark"] .form-input:focus,
[data-theme="dark"] .form-select:focus,
[data-theme="dark"] .form-textarea:focus {
  border-color: #4caf50 !important;
  box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.18) !important;
}
[data-theme="dark"] ::placeholder { color: #64748b !important; }

[data-theme="dark"] .search-box,
[data-theme="dark"] .search-box-enhanced {
  background: #0a0f1c !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .filter-section,
[data-theme="dark"] .controls-section,
[data-theme="dark"] .controls-row,
[data-theme="dark"] .tasks-controls,
[data-theme="dark"] .encyclopedia-controls,
[data-theme="dark"] .journal-controls {
  background: #14202f !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .filter-chip {
  background: #1e2d40 !important;
  border-color: #2a3b53 !important;
  color: #cbd5e1 !important;
}
[data-theme="dark"] .filter-chip:hover {
  background: #334155 !important;
  color: #f3f4f6 !important;
}

/* Buttons (only the neutral ones — leave brand greens alone) */
[data-theme="dark"] .btn-outline,
[data-theme="dark"] .btn-secondary,
[data-theme="dark"] .pc-clear-btn,
[data-theme="dark"] .pd-icon-btn,
[data-theme="dark"] .card-btn,
[data-theme="dark"] .btn-icon,
[data-theme="dark"] .view-btn {
  background: #1e2d40 !important;
  border-color: #2a3b53 !important;
  color: #cbd5e1 !important;
}
[data-theme="dark"] .btn-outline:hover,
[data-theme="dark"] .btn-secondary:hover,
[data-theme="dark"] .pd-icon-btn:hover,
[data-theme="dark"] .card-btn:hover,
[data-theme="dark"] .btn-icon:hover,
[data-theme="dark"] .view-btn:hover {
  background: #334155 !important;
  color: #f3f4f6 !important;
}
[data-theme="dark"] .view-btn.active {
  background: linear-gradient(135deg, #2e7d32, #4caf50) !important;
  color: white !important;
}

/* ── Modals ──────────────────────────────────────────── */
[data-theme="dark"] .modal-overlay { background: rgba(0,0,0,0.7) !important; }
[data-theme="dark"] .modal-content {
  background: #14202f !important;
  color: #f1f5f9 !important;
  border: 1px solid #334155 !important;
}
[data-theme="dark"] .modal-header {
  border-bottom-color: #334155 !important;
}
[data-theme="dark"] .modal-header h3 { color: #f3f4f6 !important; }
[data-theme="dark"] .modal-close {
  background: #1e2d40 !important;
  color: #cbd5e1 !important;
}

/* ── Notifications ───────────────────────────────────── */
[data-theme="dark"] .notification {
  background: #14202f !important;
  color: #f1f5f9 !important;
  border: 1px solid #334155 !important;
}

/* ── Plant Doctor ────────────────────────────────────── */
[data-theme="dark"] .pd-dropzone {
  background: #0a0f1c !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .pd-dropzone:hover {
  background: #14202f !important;
  border-color: #4caf50 !important;
}
[data-theme="dark"] .pd-result {
  background: #0a0f1c !important;
  border-color: #2a3b53 !important;
}
[data-theme="dark"] .pd-recs li {
  background: #14202f !important;
  border-color: #2a3b53 !important;
  border-left-color: #4caf50 !important;
  color: #f1f5f9 !important;
}
[data-theme="dark"] .pd-history-row:hover { background: #1e2d40 !important; }
[data-theme="dark"] .pd-history-item.active .pd-history-row { background: rgba(76, 175, 80, 0.12) !important; }
[data-theme="dark"] .pd-history-detail { background: #1a2436 !important; border-top-color: #334155 !important; }
[data-theme="dark"] .pd-notes-block p {
  background: rgba(234, 179, 8, 0.15) !important;
  color: #fde68a !important;
}

/* ── Plant Chat ──────────────────────────────────────── */
[data-theme="dark"] .pc-messages {
  background: linear-gradient(180deg, #1a2436 0%, #1e293b 100%) !important;
}
[data-theme="dark"] .pc-assistant .pc-bubble {
  background: #1e2d40 !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}
[data-theme="dark"] .pc-suggestion {
  background: #1e2d40 !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}
[data-theme="dark"] .pc-suggestion:hover {
  background: rgba(76, 175, 80, 0.15) !important;
  border-color: #4caf50 !important;
}
[data-theme="dark"] .pc-input-row { background: #14202f !important; border-top-color: #334155 !important; }
[data-theme="dark"] .pc-input { background: #0a0f1c !important; border-color: #2a3b53 !important; color: #f1f5f9 !important; }

/* Plant Chat sessions sidebar */
[data-theme="dark"] .pc-sidebar { background: #14202f !important; border-color: #2a3b53 !important; }
[data-theme="dark"] .pc-conv-item { background: #1e2d40 !important; border-color: #2a3b53 !important; }
[data-theme="dark"] .pc-conv-item:hover { background: rgba(76, 175, 80, 0.12) !important; border-color: #4caf50 !important; }
[data-theme="dark"] .pc-conv-item.active { background: rgba(76, 175, 80, 0.20) !important; border-color: #4caf50 !important; }
[data-theme="dark"] .pc-conv-title { color: #f1f5f9 !important; }
[data-theme="dark"] .pc-conv-preview, [data-theme="dark"] .pc-conv-time { color: #94a3b8 !important; }
[data-theme="dark"] .pc-conv-act { background: #14202f !important; border-color: #2a3b53 !important; color: #cbd5e1 !important; }
[data-theme="dark"] .pc-conv-empty p { color: #cbd5e1 !important; }
[data-theme="dark"] .pc-conv-empty small { color: #94a3b8 !important; }
[data-theme="dark"] .pc-conv-rename { background: #0a0f1c !important; color: #f1f5f9 !important; }
[data-theme="dark"] .pc-panel-head { background: #1e2d40 !important; border-bottom-color: #2a3b53 !important; color: #f1f5f9 !important; }

/* ── Garden Map ──────────────────────────────────────── */
[data-theme="dark"] .gm-zone-tab {
  background: #1e2d40 !important;
  color: #cbd5e1 !important;
}
[data-theme="dark"] .gm-zone-tab:hover { background: #334155 !important; }
[data-theme="dark"] .gm-palette-item {
  background: #1e2d40 !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}
[data-theme="dark"] .gm-palette-item:hover {
  background: rgba(76, 175, 80, 0.12) !important;
  border-color: #4caf50 !important;
}
[data-theme="dark"] .gm-palette-search input {
  background: #0a0f1c !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}

/* The zone canvases — keep their playful tints but darken */
[data-theme="dark"] .gm-canvas { border-color: #2a3b53 !important; filter: brightness(0.7); }

/* ── Tables / forum / discussions ────────────────────── */
[data-theme="dark"] table {
  background: #14202f !important;
  color: #f1f5f9 !important;
}
[data-theme="dark"] th { background: #1e2d40 !important; }
[data-theme="dark"] td { border-color: #2a3b53 !important; }

[data-theme="dark"] .discussion-card,
[data-theme="dark"] .reply-card,
[data-theme="dark"] .community-card {
  background: #14202f !important;
  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
}

/* ── Plant Detail tabs ───────────────────────────────── */
[data-theme="dark"] .plant-tabs { background: #14202f !important; border-color: #2a3b53 !important; }
[data-theme="dark"] .tab-btn {
  color: #cbd5e1 !important;
  background: transparent !important;
}
[data-theme="dark"] .tab-btn.active { color: #4caf50 !important; }
[data-theme="dark"] .tab-content { background: transparent !important; color: #f1f5f9 !important; }
[data-theme="dark"] .timeline-content { background: #1e2d40 !important; color: #f1f5f9 !important; }

/* ── Auth pages (Login / Register) ───────────────────── */
[data-theme="dark"] .auth-container { background: #0a0f1c !important; }
[data-theme="dark"] .auth-panel     { background: #0a0f1c !important; }
[data-theme="dark"] .auth-header h2 { color: #f3f4f6 !important; }
[data-theme="dark"] .auth-header p,
[data-theme="dark"] .auth-footer p,
[data-theme="dark"] .terms-text   { color: #94a3b8 !important; }
[data-theme="dark"] .auth-eyebrow {
  background: rgba(76, 175, 80, 0.15) !important;
  color: #6ee7b7 !important;
}
[data-theme="dark"] .form-helper,
[data-theme="dark"] .checkbox-label { color: #cbd5e1 !important; }

/* ── Theme toggle button (lives in Header) ───────────── */
.theme-toggle {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  background: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  color: #f59e0b;
  transition: all 0.25s ease;
  /* spacing comes from header-right flex gap */
}
.theme-toggle:hover {
  transform: rotate(20deg);
  border-color: #f59e0b;
}
[data-theme="dark"] .theme-toggle {
  background: #14202f !important;
  border-color: #2a3b53 !important;
  color: #fbbf24 !important;
}
[data-theme="dark"] .theme-toggle:hover {
  border-color: #fbbf24 !important;
}

/* Make scrollbars less harsh in dark mode */
[data-theme="dark"] ::-webkit-scrollbar { width: 10px; height: 10px; }
[data-theme="dark"] ::-webkit-scrollbar-track { background: #0a0f1c; }
[data-theme="dark"] ::-webkit-scrollbar-thumb {
  background: #2a3b53;
  border-radius: 999px;
}
[data-theme="dark"] ::-webkit-scrollbar-thumb:hover { background: #475569; }

/* ────────────────────────────────────────────────────────────
   Refinements pass — better contrast, missed components,
   richer surfaces for the new pages (eco, social, anatomy)
   ──────────────────────────────────────────────────────────── */

/* Body uses the deepest tone with a subtle warm tint */
[data-theme="dark"] body {
  background: linear-gradient(180deg, #0a0f1c 0%, #0d1424 100%) !important;
}

/* Hero gradients: deeper greens so they don't blast against dark surfaces */
[data-theme="dark"] .pd-hero,
[data-theme="dark"] .pc-hero,
[data-theme="dark"] .gm-hero,
[data-theme="dark"] .eco-hero,
[data-theme="dark"] .social-hero,
[data-theme="dark"] .tasks-hero,
[data-theme="dark"] .encyclopedia-hero,
[data-theme="dark"] .hero-section,
[data-theme="dark"] .journal-hero,
[data-theme="dark"] .profile-hero,
[data-theme="dark"] .profile-banner {
  background: linear-gradient(135deg, #0d2418 0%, #1f5b27 55%, #2e7d32 100%) !important;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.4) !important;
}

/* New page containers */
[data-theme="dark"] .eco-container,
[data-theme="dark"] .social-container { background: #0a0f1c !important; }

/* AI Note widget on the dashboard */
[data-theme="dark"] .ai-note-card {
  background: linear-gradient(135deg, #0e1f17 0%, #14202f 70%) !important;
  border-color: #1e3a2a !important;
}

  border-color: #2a3b53 !important;
  color: #f1f5f9 !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4) !important;
}

/* Slightly different shade for "inner" or nested cards */
[data-theme="dark"] .task-card-inner,
[data-theme="dark"] .plant-card-content,
[data-theme="dark"] .card-body,
[data-theme="dark"] .stats-grid-compact,
[data-theme="dark"] .detail-card,
[data-theme="dark"] .related-plant-card {
  background: #14202f !important;
  color: #f1f5f9 !important;
}

/* Headings & body text */

[data-theme="dark"] .stat-card,
[data-theme="dark"] .stat-card-compact,
[data-theme="dark"] .stat-card-modern,
[data-theme="dark"] .plant-card,
[data-theme="dark"] .plant-card-enhanced,
[data-theme="dark"] .plant-card-inner,
[data-theme="dark"] .task-card,
[data-theme="dark"] .journal-card,
[data-theme="dark"] .journal-form-card,
[data-theme="dark"] .journal-entries-card,
[data-theme="dark"] .post-item,
[data-theme="dark"] .health-monitor-card,
[data-theme="dark"] .spotlight-card,
[data-theme="dark"] .tasks-card,
[data-theme="dark"] .wisdom-card,
[data-theme="dark"] .community-pulse,
[data-theme="dark"] .growth-summary-card,
[data-theme="dark"] .pd-card,
[data-theme="dark"] .pc-panel,
[data-theme="dark"] .gm-canvas-header,
[data-theme="dark"] .gm-palette,
[data-theme="dark"] .gm-zones,
[data-theme="dark"] .profile-card-modern,
[data-theme="dark"] .activity-card-modern,
[data-theme="dark"] .empty-state,
[data-theme="dark"] .no-results,
